<page route="/prism/alerts/{id}" title="Alert" model="prism_alert" menu="false" roles="prism_viewer,prism_analyst,prism_admin">
  <header>
    <button label="Check now" function="check_alert_now" variant="outline" roles="prism_analyst,prism_admin"/>
    <button label="Delete alert" function="delete_alert" redirect="/prism/alerts" confirm="Delete this alert?" danger="true" roles="prism_analyst,prism_admin"/>
  </header>
  <view type="form" source="get_alert" function="set_alert" submit="Save" success="Saved">
    <group title="What to watch" cols="2">
      <field name="name" label="Name" required="true"/>
      <field name="chart" label="Number chart" fieldType="many2one" source="search_charts" optionLabel="name" entity="charts" required="true"/>
      <field name="reading" label="Reading"/>
    </group>
    <group title="When to tell me" cols="3">
      <field name="condition" label="Tell me when it" fieldType="selection" options="above, below, rises_by, falls_by, is_empty"/>
      <field name="threshold" label="Limit" fieldType="float"/>
      <field name="frequency" label="Check" fieldType="selection" options="hourly, daily, weekly"/>
      <field name="notify_clear" label="Tell me when it is back to normal"/>
      <field name="active" label="On"/>
    </group>
    <group title="How" cols="1">
      <field name="emails" label="Also email" fieldType="text"/>
      <field name="message" label="Message" fieldType="text"/>
    </group>
    <group title="Last check" cols="3">
      <field name="state" label="State" readonly="true"/>
      <field name="last_value" label="Value" readonly="true"/>
      <field name="last_checked" label="Checked" readonly="true"/>
      <field name="last_fired" label="Last needed attention" readonly="true"/>
      <field name="last_error" label="Problem" readonly="true" colspan="2"/>
    </group>
  </view>
</page>
