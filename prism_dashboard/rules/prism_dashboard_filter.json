{
  "model": "prism_dashboard_filter",
  "access": [
    {
      "name": "shared",
      "roles": [
        "prism.prism_viewer",
        "prism.prism_analyst",
        "prism.prism_admin"
      ],
      "operations": [
        "read"
      ],
      "when": {
        "shared": true
      }
    },
    {
      "name": "own",
      "operations": [
        "read",
        "write",
        "delete"
      ],
      "when": {
        "owner": "$user"
      }
    },
    {
      "name": "create",
      "roles": [
        "prism.prism_analyst",
        "prism.prism_admin"
      ],
      "operations": [
        "create"
      ]
    },
    {
      "name": "admin",
      "roles": [
        "prism.prism_admin"
      ],
      "operations": [
        "read",
        "create",
        "write",
        "delete"
      ]
    }
  ]
}
