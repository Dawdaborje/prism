<page route="/prism" title="Workbooks" model="prism_workbook" icon="layout-dashboard" sort="1" roles="prism_viewer,prism_analyst,prism_admin">
  <view type="list" model="prism_workbook" source="search_workbooks" open="/prism/workbooks/{id}"
        create="/prism/workbooks/new" create_label="New workbook" page_size="25">
    <search fields="name,description"/>
    <filter field="shared" label="Sharing" options="Shared=true,Private=false"/>
    <columns>
      <column field="name" label="Workbook" sortable="true"/>
      <column field="description" label="Description"/>
      <column field="shared" label="Shared" fieldType="boolean"/>
    </columns>
    <empty title="No workbooks yet" description="A workbook holds the charts and metrics of one analysis. Use New workbook."/>
  </view>
</page>
